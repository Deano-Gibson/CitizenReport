@model IEnumerable<Issue>

<h2>Service Request Status</h2>

<form method="get" asp-action="ServiceRequestStatus">
    <input type="text" name="searchId" placeholder="Search by ID or keyword" />
    <button type="submit">Search</button>
</form>

<table>
    <thead>
        <tr><th>ID</th><th>Category</th><th>Description</th><th>Status</th><th>Date</th></tr>
    </thead>
    <tbody>
    @foreach (var req in Model)
    {
        <tr>
            <td>@req.Id</td>
            <td>@req.Category</td>
            <td>@req.Description</td>
            <td>@req.Status</td>
            <td>@req.DateSubmitted.ToShortDateString()</td>
        </tr>
    }
    </tbody>
</table>
